{
  "compilerOptions": {
    "target": "es2018",
    "module": "Node16",
    "lib": [
      "es2018"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": false,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "Node16",
    "resolveJsonModule": true,
    "noImplicitAny": true,
    "noEmit": true,
    "types": []
  },
  "include": [
    "types/**/*",
    "test-types.ts"
  ]
}